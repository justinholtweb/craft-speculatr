{
    "name": "justinholtweb/craft-speculatr",
    "description": "Speculative loading for Craft — prefetch and prerender the page a reader is about to open, with the pages nobody should ever speculate on excluded before you have to think about it.",
    "version": "5.0.1",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "speculation-rules",
        "prerender",
        "prefetch",
        "performance",
        "core-web-vitals",
        "lcp",
        "instant-navigation"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-speculatr",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-speculatr/docs",
        "source": "https://github.com/justinholtweb/craft-speculatr",
        "issues": "https://github.com/justinholtweb/craft-speculatr/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\speculatr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\speculatr\\tests\\": "tests/"
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Speculatr",
        "handle": "speculatr",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-speculatr/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-speculatr/main/CHANGELOG.md",
        "class": "justinholtweb\\speculatr\\Plugin"
    }
}
